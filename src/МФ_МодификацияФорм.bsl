#Область Декорации

// Создаёт декорацию формы: надпись, картинку, поле картинки или разделитель.
//
// Параметры:
//   Форма    - ФормаКлиентскогоПриложения - форма.
//   Имя      - Строка - имя декорации.
//   Родитель - Строка, ЭлементФормы, ФормаКлиентскогоПриложения, Неопределено -
//              Неопределено и форма - корень формы.
//   Текст    - Строка - текст надписи или заголовок.
//   Вид      - ВидДекорацииФормы, Неопределено - Надпись, Картинка, ПолеКартинки,
//              Разделитель. Неопределено - Надпись.
//   Свойства - Структура, Неопределено - дополнительные свойства.
//
// Возвращаемое значение:
//   ДекорацияФормы
//
// Пример:
//   МФ_МодификацияФорм.СоздатьДекорацию(ЭтотОбъект, "МФ_Заголовок", ЭтотОбъект, "Расчёт бонусов");
//
Функция СоздатьДекорацию(Форма, Имя, Родитель = Неопределено, Текст = "",
	Вид = Неопределено, Свойства = Неопределено) Экспорт

	Существующая = ЭлементФормы(Форма, Имя);
	Если Существующая <> Неопределено Тогда
		Возврат Существующая;
	КонецЕсли;

	Декорация = СоздатьЭлемент(Форма, Имя, Тип("ДекорацияФормы"), Родитель);

	ВидДекорации = Вид;
	Если ВидДекорации = Неопределено Тогда
		ВидДекорации = ВидДекорацииФормы.Надпись;
	КонецЕсли;
	Декорация.Вид = ВидДекорации;

	Если ЗначениеЗаполнено(Текст) Тогда
		Декорация.Заголовок = Текст;
	КонецЕсли;

	УстановитьСвойства(Декорация, Свойства);

	Возврат Декорация;

КонецФункции

#КонецОбласти

#Область КомандыИКнопки

// Создаёт команду формы.
//
// Параметры:
//   Форма     - ФормаКлиентскогоПриложения - форма.
//   Имя       - Строка - имя команды, уникальное на форме.
//   Действие  - Строка - имя процедуры-обработчика в модуле формы (без скобок).
//   Заголовок - Строка - заголовок команды.
//   ИзменяетСохраняемыеДанные - Булево - признак изменения сохраняемых данных.
//   Картинка  - Картинка, Строка, Неопределено - картинка команды.
//
// Возвращаемое значение:
//   КомандаФормы
//
// Пример:
//   МФ_МодификацияФорм.СоздатьКоманду(ЭтотОбъект, "МФ_Пересчитать", "МФ_ПересчитатьПроцедура",
//       "Пересчитать");
//   МФ_МодификацияФорм.СоздатьКнопку(ЭтотОбъект, "МФ_ПересчитатьКнопка", "МФ_Пересчитать");
//
Функция СоздатьКоманду(Форма, Имя, Действие, Заголовок = "",
	ИзменяетСохраняемыеДанные = Ложь, Картинка = Неопределено) Экспорт

	Существующая = Форма.Команды.Найти(Имя);
	Если Существующая <> Неопределено Тогда
		Возврат Существующая;
	КонецЕсли;

	Команда = Форма.Команды.Добавить(Имя);
	Команда.Действие = Действие;
	Команда.ИзменяетСохраняемыеДанные = ИзменяетСохраняемыеДанные;

	Если ЗначениеЗаполнено(Заголовок) Тогда
		Команда.Заголовок = Заголовок;
	КонецЕсли;

	Если Картинка <> Неопределено Тогда
		Команда.Картинка = Картинка;
	КонецЕсли;

	Возврат Команда;

КонецФункции

// Создаёт кнопку формы.
// Если Родитель не указан, кнопка помещается в командную панель формы - это
// единственное умолчание, которое модуль делает за вызывающий код.
//
// Параметры:
//   Форма      - ФормаКлиентскогоПриложения - форма.
//   Имя        - Строка - имя кнопки.
//   ИмяКоманды - Строка - имя команды, созданной СоздатьКоманду.
//   Родитель   - Строка, ЭлементФормы, ФормаКлиентскогоПриложения, Неопределено -
//                Неопределено и форма - командная панель формы.
//   Заголовок  - Строка - заголовок кнопки.
//   Вид        - ВидКнопкиФормы, Неопределено - ОбычнаяКнопка или Гиперссылка.
//   Свойства   - Структура, Неопределено - дополнительные свойства.
//   События    - Структура, Неопределено - обработчики событий.
//
// Возвращаемое значение:
//   КнопкаФормы
//
// Пример:
//   МФ_МодификацияФорм.СоздатьКнопку(ЭтотОбъект, "МФ_ПересчитатьКнопка", "МФ_Пересчитать");
//
Функция СоздатьКнопку(Форма, Имя, ИмяКоманды, Родитель = Неопределено, Заголовок = "",
	Вид = Неопределено, Свойства = Неопределено, События = Неопределено) Экспорт

	Существующая = ЭлементФормы(Форма, Имя);
	Если Существующая <> Неопределено Тогда
		Возврат Существующая;
	КонецЕсли;

	РодительКнопки = Родитель;
	Если РодительКнопки = Неопределено ИЛИ РодительКнопки = Форма Тогда
		РодительКнопки = Форма.КоманднаяПанель;
	КонецЕсли;

	Кнопка = СоздатьЭлемент(Форма, Имя, Тип("КнопкаФормы"), РодительКнопки);

	ВидКнопки = Вид;
	Если ВидКнопки = Неопределено Тогда
		ВидКнопки = ВидКнопкиФормы.ОбычнаяКнопка;
	КонецЕсли;
	Кнопка.Вид = ВидКнопки;

	Кнопка.ИмяКоманды = ИмяКоманды;
	Кнопка.Отображение = ОтображениеКнопки.КартинкаИТекст;

	Если ЗначениеЗаполнено(Заголовок) Тогда
		Кнопка.Заголовок = Заголовок;
	КонецЕсли;

	УстановитьСвойства(Кнопка, Свойства);
	УстановитьСобытия(Кнопка, События);

	Возврат Кнопка;

КонецФункции

#КонецОбласти

#Область Удаление

// Удаляет элемент формы по имени или по элементу.
// Отсутствующий элемент не считается ошибкой.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - форма.
//   Имя   - Строка, ЭлементФормы - имя элемента или элемент.
//
// Пример:
//   МФ_МодификацияФорм.УдалитьЭлемент(ЭтотОбъект, "МФ_Скидка");
//
Процедура УдалитьЭлемент(Форма, Имя) Экспорт

	Элемент = ЭлементФормы(Форма, Имя);

	Если Элемент <> Неопределено Тогда
		Форма.Элементы.Удалить(Элемент);
	КонецЕсли;

КонецПроцедуры

// Удаляет элемент формы и его реквизит.
// Сначала элемент, затем реквизит: обратный порядок даёт ошибку недопустимого
// пути к данным.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - форма.
//   Имя   - Строка - имя элемента и реквизита.
//
// Пример:
//   МФ_МодификацияФорм.УдалитьЭлементИРеквизит(ЭтотОбъект, "МФ_Скидка");
//
Процедура УдалитьЭлементИРеквизит(Форма, Имя) Экспорт

	УдалитьЭлемент(Форма, Имя);
	УдалитьРеквизиты(Форма, Имя);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область Служебные

// Добавляет колонки реквизита-таблицы в массив добавляемых реквизитов.
//
// Параметры:
//   СписокРеквизитов - Массив - накопитель.
//   ИмяТаблицы       - Строка - имя реквизита-таблицы.
//   Колонки          - Структура, Соответствие - описание колонок.
//
Процедура ДобавитьКолонкиРеквизита(СписокРеквизитов, ИмяТаблицы, Колонки)

	Для Каждого ОписаниеКолонки Из Колонки Цикл

		ИмяКолонки = ОписаниеКолонки.Ключ;
		ТипКолонки = ОписаниеКолонки.Значение;
		ЗаголовокКолонки = "";

		Если ТипЗнч(ТипКолонки) = Тип("Структура") Тогда

			Если ТипКолонки.Свойство("Имя") И ЗначениеЗаполнено(ТипКолонки.Имя) Тогда
				ИмяКолонки = ТипКолонки.Имя;
			КонецЕсли;

			Если ТипКолонки.Свойство("Заголовок") Тогда
				ЗаголовокКолонки = ТипКолонки.Заголовок;
			КонецЕсли;

			ТипКолонки = ?(ТипКолонки.Свойство("Тип"), ТипКолонки.Тип, Неопределено);

		КонецЕсли;

		Реквизит = Новый РеквизитФормы(ИмяКолонки, ПривестиТипКОписанию(ТипКолонки),
			ИмяТаблицы, ЗаголовокКолонки, Ложь);
		СписокРеквизитов.Добавить(Реквизит);

	КонецЦикла;

КонецПроцедуры

// Возвращает описание ссылочного типа по виду метаданных и имени объекта.
//
// Параметры:
//   ВидТипа    - Строка - "СправочникСсылка", "ДокументСсылка", "ПеречислениеСсылка".
//   ИмяОбъекта - Строка - имя объекта метаданных.
//
// Возвращаемое значение:
//   ОписаниеТипов
//
Функция ОписаниеТипаСсылкаНа(ВидТипа, ИмяОбъекта)

	Возврат Новый ОписаниеТипов(ВидТипа + "." + ИмяОбъекта);

КонецФункции

// Возвращает массив из одного значения.
//
// Параметры:
//   Значение - Произвольный - значение.
//
// Возвращаемое значение:
//   Массив
//
Функция ВМассиве(Значение)

	Результат = Новый Массив;
	Результат.Добавить(Значение);

	Возврат Результат;

КонецФункции

